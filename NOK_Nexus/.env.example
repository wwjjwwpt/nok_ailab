# 应用配置示例文件
# 复制此文件为 .env 并填入实际配置

# 应用基础配置
APP_NAME=企业 AI 平台
APP_VERSION=1.0.0
DEBUG=True
API_PREFIX=/api/v1

# 服务器配置
HOST=0.0.0.0
PORT=8000

# ========== 阿里云 RDS 数据库配置 ==========
# 在阿里云 RDS 控制台获取连接信息
DB_HOST=your-rds-instance.mysql.rds.aliyuncs.com
DB_PORT=5432
DB_NAME=nok_ailab
DB_USER=postgres
DB_PASSWORD=your-password
DB_POOL_SIZE=10
DB_MAX_OVERFLOW=20

# ========== Redis 配置 ==========
# 阿里云 Redis 或本地部署
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_DB=0
REDIS_PASSWORD=

# ========== JWT 配置 ==========
# 生产环境务必修改为强密钥!
JWT_SECRET_KEY=your-super-secret-key-change-in-production-min-32-chars
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=60
JWT_REFRESH_TOKEN_EXPIRE_DAYS=7

# 密码加密强度
BCRYPT_ROUNDS=12

# CORS 配置 (前端地址)
CORS_ORIGINS=["http://localhost:3000","http://your-domain.com"]

# 日志配置
LOG_LEVEL=INFO
LOG_FILE=logs/app.log
