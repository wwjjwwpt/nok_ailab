/* 工作台首页样式 - 现代科技感风格 */

page {
  background-color: #f5f7fa;
}

.dashboard-container {
  min-height: 100vh;
  padding-bottom: 40rpx;
}

/* ========== 头部区域 ========== */
.header-section {
  position: relative;
  background: linear-gradient(135deg, #10b981 0%, #34d399 100%);
  padding: 140rpx 40rpx 100rpx;
  border-radius: 0 0 56rpx 56rpx;
  overflow: hidden;
}

.header-section::before {
  content: '';
  position: absolute;
  top: -80rpx;
  right: -80rpx;
  width: 300rpx;
  height: 300rpx;
  background: rgba(255, 255, 255, 0.12);
  border-radius: 50%;
}

.header-section::after {
  content: '';
  position: absolute;
  bottom: -40rpx;
  left: -40rpx;
  width: 160rpx;
  height: 160rpx;
  background: rgba(255, 255, 255, 0.08);
  border-radius: 50%;
}

.header-content {
  position: relative;
  display: flex;
  justify-content: space-between;
  align-items: flex-start;
  z-index: 1;
}

.user-info {
  display: flex;
  flex-direction: column;
  gap: 8rpx;
}

.greeting {
  font-size: 28rpx;
  color: rgba(255, 255, 255, 0.75);
}

.nickname {
  font-size: 56rpx;
  font-weight: 700;
  color: #fff;
  letter-spacing: 1rpx;
}

.subtitle {
  font-size: 26rpx;
  color: rgba(255, 255, 255, 0.65);
  margin-top: 8rpx;
}

.icon-btn {
  width: 80rpx;
  height: 80rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  background: rgba(255, 255, 255, 0.18);
  border-radius: 50%;
  backdrop-filter: blur(10rpx);
  transition: transform 0.2s;
}

.icon-btn:active {
  transform: scale(0.9);
}

.icon-btn .icon {
  font-size: 40rpx;
}

/* ========== 主要功能卡片 ========== */
.main-feature {
  padding: 0 32rpx;
  margin-top: -60rpx;
  position: relative;
  z-index: 10;
}

.feature-card {
  position: relative;
  background: #fff;
  border-radius: 32rpx;
  padding: 40rpx 32rpx;
  box-shadow: 0 12rpx 48rpx rgba(16, 185, 129, 0.2);
  overflow: hidden;
  transition: transform 0.2s, box-shadow 0.2s;
}

.feature-card:active {
  transform: scale(0.98);
  box-shadow: 0 8rpx 32rpx rgba(16, 185, 129, 0.25);
}

.feature-bg {
  position: absolute;
  top: 0;
  right: 0;
  width: 400rpx;
  height: 400rpx;
  background: linear-gradient(135deg, rgba(16, 185, 129, 0.08) 0%, rgba(52, 211, 153, 0.05) 100%);
  border-radius: 0 0 0 100%;
  pointer-events: none;
}

.feature-content {
  display: flex;
  align-items: center;
  gap: 28rpx;
  position: relative;
  z-index: 1;
}

.feature-icon {
  width: 120rpx;
  height: 120rpx;
  border-radius: 32rpx;
  background: linear-gradient(135deg, #06b6d4 0%, #3b82f6 100%);
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
  box-shadow: 0 8rpx 24rpx rgba(6, 182, 212, 0.35);
}

.icon-char {
  font-size: 56rpx;
  filter: drop-shadow(0 4rpx 8rpx rgba(0, 0, 0, 0.15));
}

.feature-text {
  flex: 1;
  display: flex;
  flex-direction: column;
  gap: 8rpx;
}

.feature-title {
  font-size: 36rpx;
  font-weight: 700;
  color: #1f2937;
}

.feature-desc {
  font-size: 26rpx;
  color: #9ca3af;
}

.feature-arrow {
  position: absolute;
  right: 32rpx;
  top: 50%;
  transform: translateY(-50%);
  font-size: 56rpx;
  color: #d1d5db;
}

/* ========== 快捷操作区域 ========== */
.quick-section {
  padding: 40rpx 32rpx 40rpx;
}

.section-title {
  font-size: 30rpx;
  font-weight: 700;
  color: #1f2937;
  margin-bottom: 24rpx;
  display: block;
}

.quick-action-card {
  background: #fff;
  border-radius: 28rpx;
  padding: 32rpx 28rpx;
  display: flex;
  align-items: center;
  gap: 24rpx;
  box-shadow: 0 4rpx 24rpx rgba(0, 0, 0, 0.06);
  transition: transform 0.2s, box-shadow 0.2s;
}

.quick-action-card:active {
  transform: scale(0.98);
  box-shadow: 0 2rpx 16rpx rgba(0, 0, 0, 0.08);
}

.action-icon-wrapper {
  width: 96rpx;
  height: 96rpx;
  border-radius: 28rpx;
  background: linear-gradient(135deg, #06b6d4 0%, #3b82f6 100%);
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
  box-shadow: 0 8rpx 24rpx rgba(6, 182, 212, 0.3);
}

.action-icon-char {
  font-size: 48rpx;
  color: #fff;
  font-weight: 300;
  margin-top: -4rpx;
}

.action-info {
  flex: 1;
  display: flex;
  flex-direction: column;
  gap: 6rpx;
}

.action-title {
  font-size: 32rpx;
  font-weight: 600;
  color: #1f2937;
}

.action-desc {
  font-size: 24rpx;
  color: #9ca3af;
}

.action-arrow {
  font-size: 48rpx;
  color: #e5e7eb;
  margin-right: 8rpx;
}
