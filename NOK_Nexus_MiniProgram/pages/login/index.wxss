/* 登录页面样式 */
.login-container {
  min-height: 100vh;
  background: linear-gradient(135deg, #001529 0%, #002140 100%);
  padding: 60rpx 40rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
}

/* 头部区域 */
.header {
  display: flex;
  flex-direction: column;
  align-items: center;
  margin-top: 120rpx;
  margin-bottom: 80rpx;
}

.logo {
  width: 120rpx;
  height: 120rpx;
  background: rgba(255, 255, 255, 0.2);
  border-radius: 24rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  margin-bottom: 32rpx;
}

.logo svg {
  width: 60rpx;
  height: 60rpx;
  color: #fff;
}

.title {
  font-size: 48rpx;
  font-weight: 600;
  color: #fff;
  margin-bottom: 16rpx;
}

.subtitle {
  font-size: 28rpx;
  color: rgba(255, 255, 255, 0.7);
}

/* 登录表单区域 */
.login-form {
  width: 100%;
  max-width: 600rpx;
}

/* 表单输入区域 */
.form-inputs {
  width: 100%;
}

.input {
  background-color: rgba(255, 255, 255, 0.1);
  border: 1rpx solid rgba(255, 255, 255, 0.2);
  border-radius: 12rpx;
  padding: 24rpx 32rpx;
  color: #fff;
  font-size: 30rpx;
  margin-bottom: 24rpx;
}

.input::placeholder {
  color: rgba(255, 255, 255, 0.5);
}

.login-btn {
  background-color: #1890ff;
  color: #fff;
  font-size: 32rpx;
  padding: 28rpx;
  border-radius: 12rpx;
  margin-top: 24rpx;
  border: none;
}

.login-btn:active {
  opacity: 0.9;
}

/* 底部说明 */
.footer {
  margin-top: auto;
  padding-bottom: 60rpx;
  display: flex;
  flex-wrap: wrap;
  justify-content: center;
  align-items: center;
  gap: 8rpx;
}

.footer-text {
  font-size: 24rpx;
  color: rgba(255, 255, 255, 0.5);
}

.link {
  font-size: 24rpx;
  color: #1890ff;
}

.button-hover {
  opacity: 0.9;
}
