/* 调研详情页面样式 - 现代卡片式设计 */

page {
  background-color: #f0f2f5;
}

.detail-container {
  min-height: 100vh;
  padding-bottom: 40rpx;
}

/* ========== 导航栏 ========== */
.nav-header {
  background: linear-gradient(135deg, #10b981 0%, #34d399 100%);
  padding: 120rpx 40rpx 30rpx;
  display: flex;
  justify-content: space-between;
  align-items: center;
  position: relative;
}

.nav-header::before {
  content: '';
  position: absolute;
  top: -60rpx;
  right: -60rpx;
  width: 200rpx;
  height: 200rpx;
  background: rgba(255, 255, 255, 0.12);
  border-radius: 50%;
}

.nav-header::after {
  content: '';
  position: absolute;
  bottom: -30rpx;
  left: 60rpx;
  width: 100rpx;
  height: 100rpx;
  background: rgba(255, 255, 255, 0.08);
  border-radius: 50%;
}

.back-btn,
.action-btn {
  width: 64rpx;
  height: 64rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  background: rgba(255, 255, 255, 0.18);
  border-radius: 50%;
  z-index: 1;
  transition: transform 0.2s;
}

.back-btn:active,
.action-btn:active {
  transform: scale(0.9);
}

.back-btn .icon,
.action-btn .icon {
  font-size: 48rpx;
  color: #fff;
  margin-top: -6rpx;
}

.page-title {
  font-size: 40rpx;
  font-weight: 700;
  color: #fff;
}

.placeholder {
  width: 64rpx;
}

/* ========== 内容区域 ========== */
.detail-content {
  padding: 24rpx 32rpx;
  display: flex;
  flex-direction: column;
  gap: 20rpx;
}

/* 信息卡片头部 */
.detail-header {
  display: flex;
  align-items: center;
  gap: 20rpx;
  padding: 16rpx 0;
}

.header-icon {
  width: 96rpx;
  height: 96rpx;
  border-radius: 28rpx;
  background: linear-gradient(135deg, #06b6d4 0%, #3b82f6 100%);
  display: flex;
  align-items: center;
  justify-content: center;
  box-shadow: 0 8rpx 24rpx rgba(6, 182, 212, 0.3);
}

.header-icon .icon-char {
  font-size: 48rpx;
}

.header-text {
  display: flex;
  flex-direction: column;
  gap: 6rpx;
}

.header-title {
  font-size: 34rpx;
  font-weight: 700;
  color: #1f2937;
}

.header-status {
  display: inline-flex;
  align-items: center;
  gap: 8rpx;
  padding: 6rpx 16rpx;
  background: linear-gradient(135deg, rgba(16, 185, 129, 0.1) 0%, rgba(52, 211, 153, 0.1) 100%);
  border-radius: 20rpx;
  font-size: 22rpx;
  color: #059669;
  font-weight: 600;
}

/* 主卡片 */
.main-card {
  background: #fff;
  border-radius: 24rpx;
  padding: 32rpx 28rpx;
  box-shadow: 0 4rpx 24rpx rgba(0, 0, 0, 0.04);
}

.info-group {
  padding: 20rpx 0;
}

.info-group:first-child {
  padding-top: 0;
}

.info-group:last-child {
  padding-bottom: 0;
}

.info-row {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 18rpx 0;
}

.info-row:first-child {
  padding-top: 0;
}

.info-row:last-child {
  padding-bottom: 0;
}

.info-label {
  display: flex;
  align-items: center;
  gap: 10rpx;
  font-size: 26rpx;
  color: #9ca3af;
}

.label-dot {
  width: 8rpx;
  height: 8rpx;
  background: #e5e7eb;
  border-radius: 50%;
}

.info-value {
  font-size: 28rpx;
  color: #1f2937;
  font-weight: 500;
}

.info-value.highlight {
  color: #10b981;
  font-weight: 700;
  font-size: 32rpx;
}

.info-divider {
  height: 1rpx;
  background: linear-gradient(to right, rgba(229, 231, 235, 0.3) 0%, #f3f4f6 50%, rgba(229, 231, 235, 0.3) 100%);
  margin: 12rpx 0;
}

/* 备注卡片 */
.remark-card {
  background: #fff;
  border-radius: 24rpx;
  padding: 32rpx 28rpx;
  box-shadow: 0 4rpx 24rpx rgba(0, 0, 0, 0.04);
}

.remark-header {
  display: flex;
  align-items: center;
  gap: 12rpx;
  margin-bottom: 20rpx;
}

.remark-icon {
  font-size: 32rpx;
}

.remark-title {
  font-size: 28rpx;
  font-weight: 600;
  color: #374151;
}

.remark-text {
  display: block;
  font-size: 28rpx;
  line-height: 1.7;
  color: #4b5563;
  background: #f8f9fa;
  padding: 24rpx;
  border-radius: 16rpx;
}

/* 审计信息 */
.audit-card {
  background: #fff;
  border-radius: 24rpx;
  padding: 32rpx 28rpx;
  box-shadow: 0 4rpx 24rpx rgba(0, 0, 0, 0.04);
}

.audit-header {
  display: flex;
  align-items: center;
  gap: 12rpx;
  margin-bottom: 20rpx;
  padding-bottom: 20rpx;
  border-bottom: 1rpx solid #f3f4f6;
}

.audit-icon {
  font-size: 32rpx;
}

.audit-title {
  font-size: 28rpx;
  font-weight: 600;
  color: #374151;
}

.audit-row {
  display: flex;
  justify-content: space-between;
  padding: 18rpx 0;
}

.audit-row:first-child {
  padding-top: 0;
}

.audit-row:last-child {
  padding-bottom: 0;
}

.audit-label {
  font-size: 26rpx;
  color: #9ca3af;
}

.audit-value {
  font-size: 26rpx;
  color: #6b7280;
  text-align: right;
  max-width: 60%;
}

/* 空状态 */
.empty-state {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 120rpx 40rpx;
}

.empty-icon {
  font-size: 100rpx;
  margin-bottom: 24rpx;
  opacity: 0.5;
}

.empty-text {
  font-size: 30rpx;
  color: #9ca3af;
}
