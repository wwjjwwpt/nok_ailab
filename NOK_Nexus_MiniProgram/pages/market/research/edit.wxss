/* 编辑调研页面样式 - 超紧凑布局 */

page {
  background-color: #f0f2f5;
}

.edit-container {
  min-height: 100vh;
  padding-bottom: 100rpx;
}

/* ========== 导航栏 ========== */
.nav-header {
  background: linear-gradient(135deg, #10b981 0%, #34d399 100%);
  padding: 40rpx 24rpx 16rpx;
  display: flex;
  justify-content: space-between;
  align-items: center;
}

.back-btn {
  width: 48rpx;
  height: 48rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  background: rgba(255, 255, 255, 0.18);
  border-radius: 50%;
}

.back-btn:active {
  transform: scale(0.9);
}

.back-btn .icon {
  font-size: 40rpx;
  color: #fff;
}

.page-title {
  font-size: 32rpx;
  font-weight: 700;
  color: #fff;
}

.placeholder {
  width: 48rpx;
}

/* ========== 表单区域 ========== */
.form-section {
  padding: 12rpx 20rpx;
  display: flex;
  flex-direction: column;
  gap: 8rpx;
}

/* 信息卡片头部 */
.form-header {
  display: flex;
  align-items: center;
  gap: 10rpx;
  padding: 4rpx 0;
}

.header-icon {
  width: 52rpx;
  height: 52rpx;
  border-radius: 12rpx;
  background: linear-gradient(135deg, #f59e0b 0%, #fbbf24 100%);
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
}

.header-icon .icon-char {
  font-size: 28rpx;
}

.header-text {
  display: flex;
  flex-direction: column;
}

.header-title {
  font-size: 28rpx;
  font-weight: 700;
  color: #1f2937;
}

.header-desc {
  font-size: 20rpx;
  color: #9ca3af;
}

/* 表单卡片 */
.form-card {
  background: #fff;
  border-radius: 12rpx;
  padding: 16rpx 16rpx;
  box-shadow: 0 1rpx 8rpx rgba(0, 0, 0, 0.04);
}

.form-group {
  padding: 8rpx 0;
}

.form-group:first-child {
  padding-top: 0;
}

.form-group:last-child {
  padding-bottom: 0;
}

.input-label {
  display: flex;
  align-items: center;
  gap: 6rpx;
  margin-bottom: 6rpx;
}

.label-dot {
  width: 5rpx;
  height: 5rpx;
  background: linear-gradient(135deg, #10b981 0%, #34d399 100%);
  border-radius: 50%;
}

.label-text {
  font-size: 24rpx;
  font-weight: 600;
  color: #374151;
}

.label-optional {
  font-size: 20rpx;
  color: #9ca3af;
}

.city-selector {
  display: flex;
  justify-content: space-between;
  align-items: center;
  background: #f8f9fa;
  border-radius: 10rpx;
  padding: 12rpx 16rpx;
  min-height: 60rpx;
}

.city-selector:active {
  background: #f3f4f6;
}

.city-text {
  font-size: 26rpx;
  color: #1f2937;
}

.city-placeholder {
  font-size: 26rpx;
  color: #9ca3af;
}

.selector-arrow {
  font-size: 28rpx;
  color: #d1d5db;
}

.input-wrapper {
  display: flex;
  align-items: center;
  background: #f8f9fa;
  border-radius: 10rpx;
  padding: 0 12rpx;
  min-height: 60rpx;
}

.input-wrapper:focus-within {
  background: #f3f4f6;
}

.input-prefix {
  font-size: 26rpx;
  margin-right: 10rpx;
  opacity: 0.7;
}

.main-input {
  flex: 1;
  font-size: 26rpx;
  color: #1f2937;
  height: 60rpx;
}

.form-divider {
  height: 1rpx;
  background: #e5e7eb;
  margin: 6rpx 0;
}

/* 日期选择器 */
.date-picker {
  display: flex;
  justify-content: space-between;
  align-items: center;
  background: #f8f9fa;
  border-radius: 10rpx;
  padding: 12rpx 16rpx;
  min-height: 60rpx;
}

.date-text {
  font-size: 26rpx;
  color: #6b7280;
}

.date-picker:active {
  background: #f3f4f6;
}

.picker-arrow {
  font-size: 28rpx;
  color: #d1d5db;
}

/* 备注文本域 */
.remark-textarea {
  width: 100%;
  font-size: 24rpx;
  color: #374151;
  background: #f8f9fa;
  border-radius: 10rpx;
  padding: 12rpx;
  line-height: 1.4;
  min-height: 100rpx;
}

/* 信息提示 */
.info-tip {
  background: rgba(16, 185, 129, 0.05);
  border-radius: 10rpx;
  padding: 12rpx 16rpx;
  border: 1rpx solid rgba(16, 185, 129, 0.1);
}

.tip-left {
  display: flex;
  align-items: center;
  gap: 8rpx;
}

.tip-icon-wrapper {
  width: 32rpx;
  height: 32rpx;
  border-radius: 50%;
  background: linear-gradient(135deg, #10b981 0%, #34d399 100%);
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
}

.tip-icon {
  font-size: 20rpx;
  color: #fff;
  font-weight: 700;
}

.tip-text {
  font-size: 20rpx;
  color: #047857;
  line-height: 1.3;
}

/* ========== 提交按钮 ========== */
.submit-section {
  position: fixed;
  bottom: 0;
  left: 0;
  right: 0;
  padding: 12rpx 20rpx 20rpx;
  background: #fff;
  border-top: 1rpx solid #e5e7eb;
}

.submit-btn {
  width: 100%;
  background: linear-gradient(135deg, #10b981 0%, #34d399 100%);
  color: #fff;
  font-size: 28rpx;
  font-weight: 600;
  padding: 24rpx 0;
  border-radius: 12rpx;
  border: none;
  box-shadow: 0 4rpx 16rpx rgba(16, 185, 129, 0.25);
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 6rpx;
}

.submit-btn:active {
  transform: scale(0.98);
}

.btn-icon {
  font-size: 28rpx;
  font-weight: 700;
}

.btn-text {
  font-size: 28rpx;
  font-weight: 600;
}

.submit-btn[loading] {
  opacity: 0.85;
}
