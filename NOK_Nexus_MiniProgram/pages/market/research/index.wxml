<!--市场调研页面-->
<view class="research-container">
  <!-- 顶部标题栏 -->
  <view class="header-section">
    <view class="header-content">
      <view class="back-btn" bindtap="goBack">
        <text class="icon">‹</text>
      </view>
      <text class="page-title">市场调研</text>
      <view class="placeholder"></view>
    </view>
    <text class="header-desc">了解市场动态，把握商机</text>
  </view>

  <!-- 统计卡片 -->
  <view class="stats-section">
    <view class="stat-card primary">
      <view class="stat-left">
        <text class="stat-label">进行中调研</text>
        <text class="stat-value">0</text>
      </view>
      <view class="stat-icon">📊</view>
    </view>
    <view class="stat-card success">
      <view class="stat-left">
        <text class="stat-label">已完成</text>
        <text class="stat-value">0</text>
      </view>
      <view class="stat-icon">✅</view>
    </view>
  </view>

  <!-- 调研列表 -->
  <view class="list-section">
    <view class="section-header">
      <text class="section-title">调研列表</text>
      <view class="filter-btn">
        <text class="filter-icon">☰</text>
        <text class="filter-text">筛选</text>
      </view>
    </view>

    <view class="empty-state">
      <view class="empty-illustration">📝</view>
      <text class="empty-title">暂无调研数据</text>
      <text class="empty-desc">创建你的第一个市场调研吧</text>
    </view>
  </view>

  <!-- 底部创建按钮 -->
  <view class="fab-button" bindtap="createResearch">
    <text class="fab-icon">＋</text>
  </view>
</view>
