/* 市场调研页面样式 - 现代简约风格 */

page {
  background-color: #f8f9fa;
}

.research-container {
  min-height: 100vh;
  padding-bottom: 160rpx;
}

/* ========== 头部区域 ========== */
.header-section {
  position: relative;
  background: linear-gradient(135deg, #6366f1 0%, #8b5cf6 50%, #d946ef 100%);
  padding: 140rpx 40rpx 60rpx;
  border-radius: 0 0 40rpx 40rpx;
  overflow: hidden;
}

.header-section::before {
  content: '';
  position: absolute;
  top: -80rpx;
  right: -80rpx;
  width: 300rpx;
  height: 300rpx;
  background: rgba(255, 255, 255, 0.1);
  border-radius: 50%;
}

.header-content {
  position: relative;
  display: flex;
  justify-content: space-between;
  align-items: center;
  z-index: 1;
}

.back-btn {
  width: 64rpx;
  height: 64rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  background: rgba(255, 255, 255, 0.15);
  border-radius: 50%;
}

.back-btn .icon {
  font-size: 48rpx;
  color: #fff;
  margin-top: -8rpx;
}

.page-title {
  font-size: 40rpx;
  font-weight: 700;
  color: #fff;
  letter-spacing: 1rpx;
}

.placeholder {
  width: 64rpx;
}

.header-desc {
  position: relative;
  display: block;
  margin-top: 16rpx;
  font-size: 26rpx;
  color: rgba(255, 255, 255, 0.6);
}

/* ========== 统计卡片 ========== */
.stats-section {
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 24rpx;
  padding: 32rpx;
  margin-top: -40rpx;
}

.stat-card {
  position: relative;
  background: #fff;
  border-radius: 28rpx;
  padding: 32rpx 28rpx;
  box-shadow: 0 8rpx 32rpx rgba(0, 0, 0, 0.08);
  display: flex;
  justify-content: space-between;
  align-items: center;
  overflow: hidden;
}

.stat-card::before {
  content: '';
  position: absolute;
  top: 0;
  left: 0;
  right: 0;
  height: 6rpx;
  border-radius: 28rpx 28rpx 0 0;
}

.stat-card.primary::before {
  background: linear-gradient(90deg, #667eea 0%, #764ba2 100%);
}

.stat-card.success::before {
  background: linear-gradient(90deg, #11998e 0%, #38ef7d 100%);
}

.stat-left {
  display: flex;
  flex-direction: column;
  gap: 12rpx;
}

.stat-label {
  font-size: 24rpx;
  color: #9ca3af;
}

.stat-value {
  font-size: 48rpx;
  font-weight: 700;
  color: #1f2937;
}

.stat-icon {
  font-size: 56rpx;
  opacity: 0.8;
}

/* ========== 列表区域 ========== */
.list-section {
  background: #fff;
  margin: 0 32rpx;
  border-radius: 24rpx;
  overflow: hidden;
  box-shadow: 0 4rpx 24rpx rgba(0, 0, 0, 0.06);
}

.section-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 24rpx 28rpx;
  border-bottom: 1rpx solid #f3f4f6;
}

.section-title {
  font-size: 30rpx;
  font-weight: 600;
  color: #1f2937;
}

.filter-btn {
  display: flex;
  align-items: center;
  gap: 8rpx;
  padding: 12rpx 20rpx;
  background: #f9fafb;
  border-radius: 12rpx;
}

.filter-icon {
  font-size: 28rpx;
  color: #6b7280;
}

.filter-text {
  font-size: 24rpx;
  color: #6b7280;
}

/* ========== 空状态 ========== */
.empty-state {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 120rpx 40rpx;
}

.empty-illustration {
  font-size: 120rpx;
  margin-bottom: 32rpx;
  opacity: 0.6;
}

.empty-title {
  font-size: 32rpx;
  font-weight: 600;
  color: #1f2937;
  margin-bottom: 12rpx;
}

.empty-desc {
  font-size: 26rpx;
  color: #9ca3af;
}

/* ========== 悬浮按钮 ========== */
.fab-button {
  position: fixed;
  bottom: 40rpx;
  right: 40rpx;
  width: 112rpx;
  height: 112rpx;
  border-radius: 50%;
  background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
  box-shadow: 0 12rpx 40rpx rgba(102, 126, 234, 0.45);
  display: flex;
  align-items: center;
  justify-content: center;
  z-index: 100;
  transition: transform 0.2s;
}

.fab-button:active {
  transform: scale(0.9);
}

.fab-icon {
  font-size: 56rpx;
  color: #fff;
  font-weight: 300;
  margin-top: -8rpx;
}
