/* 市场调研列表页样式 - 现代卡片式设计 */

page {
  background-color: #f0f2f5;
}

.research-list-container {
  min-height: 100vh;
  padding-bottom: 160rpx;
}

/* ========== 导航栏 ========== */
.nav-header {
  background: linear-gradient(135deg, #10b981 0%, #34d399 100%);
  padding: 120rpx 40rpx 30rpx;
  display: flex;
  justify-content: space-between;
  align-items: center;
  position: relative;
}

.nav-header::before {
  content: '';
  position: absolute;
  top: -60rpx;
  right: -60rpx;
  width: 200rpx;
  height: 200rpx;
  background: rgba(255, 255, 255, 0.12);
  border-radius: 50%;
}

.nav-header::after {
  content: '';
  position: absolute;
  bottom: -30rpx;
  left: 60rpx;
  width: 100rpx;
  height: 100rpx;
  background: rgba(255, 255, 255, 0.08);
  border-radius: 50%;
}

.back-btn {
  width: 64rpx;
  height: 64rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  background: rgba(255, 255, 255, 0.18);
  border-radius: 50%;
  z-index: 1;
  transition: transform 0.2s;
}

.back-btn:active {
  transform: scale(0.9);
}

.back-btn .icon {
  font-size: 48rpx;
  color: #fff;
  margin-top: -6rpx;
}

.page-title {
  font-size: 40rpx;
  font-weight: 700;
  color: #fff;
}

.placeholder {
  width: 64rpx;
}

/* ========== 统计卡片 ========== */
.stats-card {
  background: #fff;
  margin: 24rpx 32rpx;
  padding: 32rpx;
  border-radius: 24rpx;
  box-shadow: 0 4rpx 24rpx rgba(0, 0, 0, 0.04);
}

.stat-item {
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 8rpx;
}

.stat-value {
  font-size: 48rpx;
  font-weight: 700;
  background: linear-gradient(135deg, #10b981 0%, #34d399 100%);
  -webkit-background-clip: text;
  -webkit-text-fill-color: transparent;
  background-clip: text;
}

.stat-label {
  font-size: 24rpx;
  color: #9ca3af;
}

/* ========== 搜索栏 ========== */
.search-bar {
  display: flex;
  gap: 16rpx;
  padding: 0 32rpx 24rpx;
}

.search-input {
  flex: 1;
  display: flex;
  align-items: center;
  background: #fff;
  border-radius: 20rpx;
  padding: 0 28rpx;
  height: 88rpx;
  box-shadow: 0 2rpx 12rpx rgba(0, 0, 0, 0.04);
}

.search-icon {
  font-size: 32rpx;
  margin-right: 16rpx;
  opacity: 0.5;
}

.search-field {
  flex: 1;
  font-size: 28rpx;
  height: 100%;
}

.search-btn {
  background: linear-gradient(135deg, #10b981 0%, #34d399 100%);
  color: #fff;
  padding: 0 36rpx;
  border-radius: 20rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 28rpx;
  font-weight: 600;
  height: 88rpx;
  box-shadow: 0 4rpx 16rpx rgba(16, 185, 129, 0.3);
  transition: transform 0.2s, box-shadow 0.2s;
}

.search-btn:active {
  transform: scale(0.95);
  box-shadow: 0 2rpx 12rpx rgba(16, 185, 129, 0.25);
}

/* ========== 列表区域 ========== */
.list-section {
  padding: 0 32rpx;
}

.list-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 20rpx 0;
  margin-bottom: 16rpx;
}

.list-title {
  font-size: 30rpx;
  font-weight: 700;
  color: #1f2937;
}

.list-count {
  font-size: 24rpx;
  color: #9ca3af;
}

/* ========== 调研项 ========== */
.research-list {
  display: flex;
  flex-direction: column;
  gap: 20rpx;
}

.research-item {
  background: #fff;
  border-radius: 24rpx;
  padding: 28rpx 24rpx;
  box-shadow: 0 4rpx 24rpx rgba(0, 0, 0, 0.04);
  transition: transform 0.2s, box-shadow 0.2s;
}

.research-item:active {
  transform: scale(0.98);
  box-shadow: 0 2rpx 12rpx rgba(0, 0, 0, 0.06);
}

.item-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 20rpx;
}

.item-city {
  display: flex;
  align-items: center;
  gap: 10rpx;
}

.city-icon {
  font-size: 28rpx;
}

.city-name {
  font-size: 30rpx;
  font-weight: 600;
  color: #1f2937;
}

.item-date {
  display: inline-flex;
  align-items: center;
  padding: 6rpx 16rpx;
  background: linear-gradient(135deg, rgba(16, 185, 129, 0.1) 0%, rgba(52, 211, 153, 0.1) 100%);
  border-radius: 20rpx;
  font-size: 22rpx;
  color: #059669;
  font-weight: 600;
}

.item-body {
  display: flex;
  flex-direction: column;
  gap: 14rpx;
  margin-bottom: 20rpx;
  background: #f8f9fa;
  padding: 20rpx;
  border-radius: 16rpx;
}

.item-row {
  display: flex;
  align-items: baseline;
  gap: 8rpx;
}

.item-label {
  font-size: 24rpx;
  color: #9ca3af;
}

.item-value {
  font-size: 28rpx;
  color: #374151;
  font-weight: 500;
}

.item-price {
  font-size: 34rpx;
  font-weight: 700;
  color: #10b981;
}

.item-footer {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding-top: 16rpx;
  border-top: 1rpx solid #f3f4f6;
}

.item-time {
  font-size: 22rpx;
  color: #d1d5db;
}

.item-actions {
  width: 56rpx;
  height: 56rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  background: #f9fafb;
  border-radius: 50%;
  transition: background-color 0.2s;
}

.item-actions:active {
  background: #f3f4f6;
}

.action-icon {
  font-size: 32rpx;
  color: #9ca3af;
}

/* ========== 空状态 ========== */
.empty-state {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 120rpx 40rpx;
  background: #fff;
  border-radius: 24rpx;
  box-shadow: 0 4rpx 24rpx rgba(0, 0, 0, 0.04);
}

.empty-icon {
  font-size: 100rpx;
  margin-bottom: 24rpx;
  opacity: 0.5;
}

.empty-text {
  font-size: 30rpx;
  color: #6b7280;
  margin-bottom: 12rpx;
}

.empty-hint {
  font-size: 26rpx;
  color: #9ca3af;
}

/* ========== 加载更多 ========== */
.load-more,
.no-more {
  text-align: center;
  padding: 32rpx;
  font-size: 24rpx;
  color: #9ca3af;
}

/* ========== 悬浮按钮 ========== */
.fab-button {
  position: fixed;
  bottom: 40rpx;
  right: 40rpx;
  width: 120rpx;
  height: 120rpx;
  border-radius: 50%;
  background: linear-gradient(135deg, #10b981 0%, #34d399 100%);
  box-shadow: 0 12rpx 48rpx rgba(16, 185, 129, 0.4);
  display: flex;
  align-items: center;
  justify-content: center;
  z-index: 100;
  transition: transform 0.2s, box-shadow 0.2s;
}

.fab-button:active {
  transform: scale(0.92);
  box-shadow: 0 8rpx 36rpx rgba(16, 185, 129, 0.35);
}

.fab-icon {
  font-size: 64rpx;
  color: #fff;
  font-weight: 300;
  margin-top: -8rpx;
}
