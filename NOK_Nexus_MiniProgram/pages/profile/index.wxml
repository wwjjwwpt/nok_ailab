<!--个人中心-->
<view class="profile-container">
  <!-- 用户信息卡片 -->
  <view class="user-card">
    <image class="avatar" src="{{userInfo.avatar || '/images/default-avatar.png'}}" mode="aspectFill" />
    <view class="user-info">
      <text class="nickname">{{userInfo.nickname || userInfo.username}}</text>
      <text class="username">{{userInfo.username}}</text>
    </view>
  </view>

  <!-- 功能列表 -->
  <view class="menu-list">
    <view class="menu-item" bindtap="navigateTo" data-url="/pages/profile/settings">
      <text class="icon">⚙️</text>
      <text class="name">账号设置</text>
      <text class="arrow">›</text>
    </view>
    <view class="menu-item" bindtap="navigateTo" data-url="/pages/profile/password">
      <text class="icon">🔒</text>
      <text class="name">修改密码</text>
      <text class="arrow">›</text>
    </view>
    <view class="menu-item" bindtap="navigateTo" data-url="/pages/profile/bind">
      <text class="icon">📱</text>
      <text class="name">账号绑定</text>
      <text class="arrow">›</text>
    </view>
    <view class="menu-item" bindtap="navigateTo" data-url="/pages/profile/about">
      <text class="icon">ℹ️</text>
      <text class="name">关于我们</text>
      <text class="arrow">›</text>
    </view>
  </view>

  <!-- 退出登录按钮 -->
  <view class="logout-section">
    <button class="logout-btn" bindtap="handleLogout">
      退出登录
    </button>
  </view>
</view>
