/* 个人中心样式 */
.profile-container {
  min-height: 100vh;
  background-color: #f5f5f5;
  padding: 40rpx;
}

/* 用户信息卡片 */
.user-card {
  background: linear-gradient(135deg, #001529 0%, #003a8c 100%);
  border-radius: 20rpx;
  padding: 48rpx 40rpx;
  display: flex;
  align-items: center;
  gap: 32rpx;
  margin-bottom: 40rpx;
}

.avatar {
  width: 120rpx;
  height: 120rpx;
  border-radius: 50%;
  border: 4rpx solid rgba(255, 255, 255, 0.3);
}

.user-info {
  display: flex;
  flex-direction: column;
  gap: 12rpx;
}

.nickname {
  font-size: 40rpx;
  font-weight: 600;
  color: #fff;
}

.username {
  font-size: 26rpx;
  color: rgba(255, 255, 255, 0.7);
}

/* 功能列表 */
.menu-list {
  background-color: #fff;
  border-radius: 16rpx;
  overflow: hidden;
  margin-bottom: 40rpx;
}

.menu-item {
  display: flex;
  align-items: center;
  padding: 32rpx 24rpx;
  border-bottom: 1rpx solid #f0f0f0;
  gap: 24rpx;
}

.menu-item:last-child {
  border-bottom: none;
}

.menu-item:active {
  background-color: #f5f5f5;
}

.icon {
  font-size: 40rpx;
}

.name {
  flex: 1;
  font-size: 30rpx;
  color: #333;
}

.arrow {
  font-size: 40rpx;
  color: #ccc;
}

/* 退出登录 */
.logout-section {
  padding: 0 20rpx;
}

.logout-btn {
  background-color: #fff;
  color: #ff4d4f;
  font-size: 30rpx;
  padding: 28rpx;
  border-radius: 16rpx;
  border: 1rpx solid #ffccc7;
}

.logout-btn:active {
  background-color: #fff1f0;
}
